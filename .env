# ===== Настройки сервера =====

# Версия Minecraft — та же, что у вашей хоррор-сборки
MC_VERSION=1.20.1

# Загрузчик модов: forge | fabric | quinque
# Как проверить: откройте зип сборки → внутри в модах есть файл mods.toml = forge,
# fabric.mod.json = fabric
MOD_LOADER=forge

# Память сервера.
# ВДС на 1 ГБ → оставляем 768M + свап (см. README).
# Если ВДС станет 4 ГБ → MEMORY=3G, если 8 ГБ → MEMORY=5G
MEMORY=768M

# Где лежит зип с модпаком (внутри контейнера)
# На сервере кладите ваш pack.zip в папку pack/
MOD_FILE=/pack/pack.zip

# Лёгкие флаги JVM под маленький ВДС
SERVER_JVM_FLAGS=-XX:+UseG1GC -XX:MaxGCPauseMillis=50 -XX:MaxMetaspaceSize=384m -XX:+ParallelRefProcEnabled

# Название сервера в списке (MOTD)
MOTD=Horror server 1.20.1
